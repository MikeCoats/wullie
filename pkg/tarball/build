#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Mike Coats <i.am@mikecoats.com>
# SPDX-License-Identifier: GPL-3.0-or-later

# Builds a release tarball, and its checksum, in dist/.
# `just tarball <target>` runs this; the target defaults to this machine's.
#
# Usage: pkg/tarball/build <target>

set -euo pipefail

if [[ ${#} -ne 1 ]]; then
    echo "usage: ${0} <target>" >&2
    exit 2
fi
target="${1}"

here="$(cd "$(dirname "${0}")" && pwd)"
cd "${here}/../.."

version=$(cargo pkgid | sed 's/.*[#@]//')
name="wullie-${version}-${target}"
exe=""
if [[ "${target}" == *-windows-* ]]; then exe=".exe"; fi
mtime=$(git log -1 --format=%ct)

cargo build --release --target "${target}"

if [[ "${target}" == *-linux-gnu ]]; then
    # Linux binaries run where glibc has every symbol version they use.
    # Debian 12, the oldest release we support, has glibc 2.36.
    oldest="2.36"
    needed=$(objdump -T "target/${target}/release/wullie" | grep -o 'GLIBC_[0-9.]*' | sort -uV | tail -1)
    needed="${needed#GLIBC_}"
    newer=$(printf '%s\n' "${oldest}" "${needed}" | sort -V | tail -1)
    if [[ "${newer}" != "${oldest}" ]]; then
        echo "error: wullie needs glibc ${needed}, but Debian 12 has ${oldest}" >&2
        exit 1
    fi
    echo "wullie needs glibc ${needed}, Debian 12 has ${oldest}"
fi

rm -rf "dist/${name}"
mkdir -p "dist/${name}"
cargo xtask man --out-dir "dist/${name}"
cargo xtask completions --out-dir "dist/${name}/completions"
cp "target/${target}/release/wullie${exe}" README.md "dist/${name}/"
cp -r LICENSES "dist/${name}/"
"${TAR:-tar}" --sort=name --owner=0 --group=0 --numeric-owner \
    --mtime="@${mtime}" \
    -C dist -czf "dist/${name}.tar.gz" "${name}"

# Git for Windows has `sha256sum` but may not have `shasum`; macOS may be
# the other way round. Both write the same format.
if command -v sha256sum > /dev/null; then sum=(sha256sum); else sum=(shasum -a 256); fi
(cd dist && "${sum[@]}" "${name}.tar.gz" > "${name}.tar.gz.sha256")
echo "dist/${name}.tar.gz"
